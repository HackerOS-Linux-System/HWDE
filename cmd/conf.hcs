get <bit:gui>
include <sys>

!! ============================================================================
!! HWDE - konfiguracja (~/.config/hwde/hwde.conf), tlumaczenia, motyw i CSS
!! ============================================================================

struct Conf [
    kv: Dict<Str, Str>,
    lang: Str,
    path: Str
]

!! ---------------------------------------------------------------- sciezki
fun home_dir() -> Str [
    let h = gui_env("HOME")
    if h == "" [
        end "/tmp"
    ]
    end h
]

fun conf_dir() -> Str [
    let x = gui_env("XDG_CONFIG_HOME")
    if x == "" [
        end home_dir() + "/.config/hwde"
    ]
    end x + "/hwde"
]

fun conf_path() -> Str [
    end conf_dir() + "/hwde.conf"
]

fun css_path() -> Str [
    end conf_dir() + "/custom.css"
]

fun labwc_dir() -> Str [
    let x = gui_env("XDG_CONFIG_HOME")
    if x == "" [
        end home_dir() + "/.config/labwc"
    ]
    end x + "/labwc"
]

