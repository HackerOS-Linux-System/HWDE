    let a: List<Element> = [ r_toggle(s.clone(), tr(c.clone(), "Powiadomienia", "Notifications"), tr(c.clone(), "Wbudowany demon org.freedesktop.Notifications", "Built-in org.freedesktop.Notifications daemon"), "notify.enabled"), r_toggle(s.clone(), tr(c.clone(), "Nie przeszkadzać", "Do not disturb"), "", "notify.dnd"), r_slider(s.clone(), tr(c.clone(), "Czas wyświetlania", "Display time"), "", "notify.timeout", 2.0, 20.0, " s"), r_slider(s.clone(), tr(c.clone(), "Maks. jednocześnie", "Max. at once"), "", "notify.max", 1.0, 8.0, "") ]
    let b: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Zablokuj po bezczynności", "Lock after idle"), tr(c.clone(), "Zmiana działa po restarcie powłoki", "Applies after the shell restarts"), "lock.timeout"), r_pick(s.clone(), tr(c.clone(), "Wyłącz ekran po bezczynności", "Turn screen off after idle"), tr(c.clone(), "Wymaga programu wlopm", "Requires wlopm"), "lock.screen_off") ]
    end column([ page_head(s.clone(), 5), group(th.clone(), tr(c.clone(), "Powiadomienia", "Notifications"), a), group(th.clone(), tr(c.clone(), "Blokada ekranu", "Screen lock"), b) ]).spacing(20.0).fill_width()
]

fun list_keys(c: Conf, prefix: Str) -> List<Str> [
    let keys = c.kv.keys()
    let names: List<Str> = []
    let i = 0
    while i < keys.len() [
        if s_starts(keys[i].clone(), prefix.clone()) [
            names.push(keys[i].clone())
        ]
        i = i + 1
    ]
    end sort_strs(names)
]

fun page_apps(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let apps: List<Element> = [ r_text(s.clone(), tr(c.clone(), "Terminal", "Terminal"), tr(c.clone(), "puste = wykryj automatycznie: ", "empty = autodetect: ") + role_command(conf_default(), "terminal"), "apps.terminal", role_command(conf_default(), "terminal")), r_text(s.clone(), tr(c.clone(), "Przeglądarka", "Browser"), "", "apps.browser", role_command(conf_default(), "browser")), r_text(s.clone(), tr(c.clone(), "Menedżer plików", "File manager"), "", "apps.files", role_command(conf_default(), "files")), r_text(s.clone(), tr(c.clone(), "Edytor", "Editor"), "", "apps.editor", role_command(conf_default(), "editor")) ]
    let rows: List<Element> = []
    let ks = list_keys(c.clone(), "keys.")
    let i = 0
    while i < ks.len() [
        let v = cget(c.clone(), ks[i].clone())
        if v != "" [
            let del = button("").with_icon("trash").on_press("kdel:" + ks[i]).class("ghost icon")
            let line = row([ text(key_of(ks[i].clone())).size(13.0).bold().width(fixed(190.0)), text_input("exec:… / action:…", v).id(ks[i].clone()).on_input("t:" + ks[i]).fill_width(), del ]).spacing(10.0).align_y(1).padding_xy(16.0, 6.0).fill_width()
            rows.push(line)
        ]
        i = i + 1
    ]
    let add = row([ text_input(tr(c.clone(), "Skrót, np. W-t", "Shortcut, e.g. W-t"), s.new_key.clone()).id("new_key").on_input("nk").width(fixed(190.0)), text_input(tr(c.clone(), "exec:polecenie lub action:Nazwa", "exec:command or action:Name"), s.new_cmd.clone()).id("new_cmd").on_input("nc").on_submit("kadd").fill_width(), button(tr(c.clone(), "Dodaj", "Add")).with_icon("plus").on_press("kadd").class("primary") ]).spacing(10.0).align_y(1).padding_xy(16.0, 10.0).fill_width()
    rows.push(add)
    let auto: List<Element> = []
    let autos = list_keys(c.clone(), "autostart.")
    let k = 0
    while k < autos.len() [
        let del2 = button("").with_icon("trash").on_press("adel:" + autos[k]).class("ghost icon")
        auto.push(row([ text_input("", cget(c.clone(), autos[k].clone())).id(autos[k].clone()).on_input("t:" + autos[k]).fill_width(), del2 ]).spacing(10.0).align_y(1).padding_xy(16.0, 6.0).fill_width())
        k = k + 1
    ]
    auto.push(row([ text_input(tr(c.clone(), "Polecenie uruchamiane przy logowaniu", "Command to run at login"), s.new_auto.clone()).id("new_auto").on_input("na").on_submit("aadd").fill_width(), button(tr(c.clone(), "Dodaj", "Add")).with_icon("plus").on_press("aadd").class("primary") ]).spacing(10.0).align_y(1).padding_xy(16.0, 10.0).fill_width())
    end column([ page_head(s.clone(), 6), group(th.clone(), tr(c.clone(), "Aplikacje domyślne", "Default apps"), apps), group(th.clone(), tr(c.clone(), "Skróty klawiszowe (W = Super, A = Alt, C = Ctrl, S = Shift)", "Keyboard shortcuts (W = Super, A = Alt, C = Ctrl, S = Shift)"), rows), group(th.clone(), tr(c.clone(), "Autostart", "Autostart"), auto) ]).spacing(20.0).fill_width()
]

fun page_system(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let kern = out_of("uname", ["-sr"])
    let lw = "labwc"
    if hw_which("labwc") [
        lw = out_of("labwc", ["--version"])
    ]
    let a: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Język", "Language"), "", "general.language") ]
    let reset_label = tr(c.clone(), "Przywróć domyślne", "Reset to defaults")
    if s.confirm [
        reset_label = tr(c.clone(), "Na pewno? Kliknij ponownie", "Sure? Click again")
    ]
    let acts = row([ button(tr(c.clone(), "Edytuj hwde.conf", "Edit hwde.conf")).with_icon("pencil").on_press("edit_conf"), button(tr(c.clone(), "Edytuj custom.css", "Edit custom.css")).with_icon("pencil").on_press("edit_css"), button(tr(c.clone(), "Przeładuj labwc", "Reload labwc")).with_icon("refresh-cw").on_press("reload"), button(reset_label).with_icon("trash").class("danger").on_press("reset") ]).spacing(10.0)
    let b: List<Element> = [ srow(th.clone(), "HWDE", tr(c.clone(), "HackerOS Wayland Desktop Environment", "HackerOS Wayland Desktop Environment"), text("0.1").bold()), srow(th.clone(), tr(c.clone(), "Kompozytor", "Compositor"), "", text(lw.clone()).size(13.0)), srow(th.clone(), tr(c.clone(), "Jądro", "Kernel"), "", text(kern.clone()).size(13.0)), srow(th.clone(), tr(c.clone(), "Konfiguracja", "Configuration"), conf_path(), text("")) ]
    end column([ page_head(s.clone(), 7), group(th.clone(), tr(c.clone(), "Ogólne", "General"), a), group(th.clone(), tr(c.clone(), "O systemie", "About"), b), acts, text(s.status.clone()).size(12.0).color(th.p.subtext) ]).spacing(20.0).fill_width()
]

fun settings_view(s: SState) -> Element [
    let th = s.th.clone()
    let items: List<Element> = [ text("HWDE").size(13.0).bold().color(th.p.subtext).padding_4(10.0, 0.0, 8.0, 12.0) ]
    let i = 0
    while i < page_count() [
        let line = row([ icon(page_icon(i)).size(17.0), text(page_title(s.c.clone(), i)).size(14.0) ]).spacing(12.0).align_y(1)
        let b = button_with(line).on_press("page:" + (i as Str)).class("ghost").fill_width().padding_xy(12.0, 9.0)
        b.st.ax = 0
        if i == s.page [
            b = b.background(with_alpha(th.p.text, 24))
        ]
        items.push(b)
        i = i + 1
    ]
    let side = container(column(items).spacing(2.0).fill_width()).width(fixed(240.0)).fill_height().padding(10.0).background(th.p.surface)
    let page = page_system(s.clone())
    if s.page == 0 [
        page = page_appearance(s.clone())
    ]
    if s.page == 1 [
        page = page_panel(s.clone())
    ]
    if s.page == 2 [
        page = page_windows(s.clone())
    ]
    if s.page == 3 [
        page = page_input(s.clone())
    ]
    if s.page == 4 [
        page = page_display(s.clone())
    ]
    if s.page == 5 [
        page = page_notify(s.clone())
    ]
    if s.page == 6 [
        page = page_apps(s.clone())
    ]
    let body = scrollable(container(page).padding(28.0).fill_width()).fill_all()
    end row([ side, body ]).fill_all()
]

!! ---------------------------------------------------------------- aktualizacja
fun conf_without(c: Conf, key: Str) -> Conf [
    let keep: Dict<Str, Str> = dict()
    let all = c.kv.keys()
    let q = 0
    while q < all.len() [
        if all[q] != key [
            keep.insert(all[q].clone(), cget(c.clone(), all[q].clone()))
        ]
        q = q + 1
    ]
    end Conf(keep, c.lang.clone(), c.path.clone())
]

fun next_auto_key(c: Conf) -> Str [
    let n = list_keys(c.clone(), "autostart.").len() + 1
    let name = "autostart.a" + pad3(n)
    while cget(c.clone(), name.clone()) != "" [
        n = n + 1
        name = "autostart.a" + pad3(n)
    ]
    end name
]

fun pad3(n: Int) -> Str [
    if n < 10 [
        end "00" + (n as Str)
    ]
    if n < 100 [
        end "0" + (n as Str)
    ]
    end n as Str
]

fun settings_update(s: SState, m: Message, now: Int) -> SState [
    let n = s.clone()
    n.outputs = outputs_update(n.outputs.clone(), m)
    let changed = false
    let id = m.id.clone()
    if s_starts(id.clone(), "page:") [
        n.page = parse_i(s_sub(id.clone(), 5, slen(id.clone())))
        n.confirm = false
    ]
    if s_starts(id.clone(), "b:") [
        cset_b(n.c, s_sub(id.clone(), 2, slen(id.clone())), m.flag)
        changed = true
    ]
    if s_starts(id.clone(), "s:") [
        let key = s_sub(id.clone(), 2, slen(id.clone()))
        let v = m.num
        if key == "input.pointer_speed" [
            cset(n.c, key, fmt_float(fround(v * 10.0) / 10.0, 1))
        ] else [
            cset(n.c, key, (fround(v) as Int) as Str)
        ]
        changed = true
    ]
    if s_starts(id.clone(), "t:") [
        cset(n.c, s_sub(id.clone(), 2, slen(id.clone())), m.text.clone())
        changed = true
    ]
    if s_starts(id.clone(), "p:") [
        let key2 = s_sub(id.clone(), 2, slen(id.clone()))
        let vals = enum_vals(key2.clone())
        if m.idx >= 0 and m.idx < vals.len() [
            cset(n.c, key2.clone(), vals[m.idx].clone())
            changed = true
            if key2 == "general.language" [
                n.c.lang = resolve_lang(n.c.clone())
            ]
        ]
    ]
    if s_starts(id.clone(), "acc:") [
        cset(n.c, "appearance.accent", s_sub(id.clone(), 4, slen(id.clone())))
        changed = true
    ]
    if s_starts(id.clone(), "ds:") [
        let out = s_sub(id.clone(), 3, slen(id.clone()))
        let vals2 = enum_vals("display.scale")
        if m.idx >= 0 and m.idx < vals2.len() [
            cset(n.c, "display.scale." + out, vals2[m.idx].clone())
            if hw_which("wlr-randr") [
                hw_status("wlr-randr", ["--output", out, "--scale", vals2[m.idx].clone()])
            ]
            changed = true
        ]
    ]
    if id == "vol" [
        n.vol = fround(m.num) as Int
        vol_set(n.vol)
    ]
    if id == "bright" [
        n.bright = fround(m.num) as Int
        bright_set(n.bright)
    ]
    if id == "mute" [
        vol_toggle_mute()
        n.muted = vol_muted()
    ]
    if id == "nk" [
        n.new_key = m.text.clone()
    ]
    if id == "nc" [
        n.new_cmd = m.text.clone()
    ]
    if id == "na" [
        n.new_auto = m.text.clone()
    ]
    if id == "kadd" [
        if trim(n.new_key.clone()) != "" and trim(n.new_cmd.clone()) != "" [
            cset(n.c, "keys." + trim(n.new_key.clone()), trim(n.new_cmd.clone()))
            n.new_key = ""
            n.new_cmd = ""
            changed = true
        ]
    ]
    if s_starts(id.clone(), "kdel:") [
        cset(n.c, s_sub(id.clone(), 5, slen(id.clone())), "")
        changed = true
    ]
    if id == "aadd" [
        if trim(n.new_auto.clone()) != "" [
            let akey = next_auto_key(n.c.clone())
            cset(n.c, akey, trim(n.new_auto.clone()))
            n.new_auto = ""
            changed = true
        ]
    ]
    if s_starts(id.clone(), "adel:") [
        let kk = s_sub(id.clone(), 5, slen(id.clone()))
        n.c = conf_without(n.c.clone(), kk)
        changed = true
    ]
    if id == "edit_conf" [
        conf_save(n.c.clone())
        sh(role_command(n.c.clone(), "editor") + " '" + conf_path() + "'")
    ]
    if id == "edit_css" [
        if gui_file_size(css_path()) < 0 [
            gui_write_file(css_path(), "/* HWDE: wlasny CSS. Przyklad:\nbutton.primary { border-radius: 999px; }\n*/\n")
        ]
        sh(role_command(n.c.clone(), "editor") + " '" + css_path() + "'")
    ]
    if id == "reload" [
        labwc_apply(n.c.clone(), true)
        n.status = tr(n.c.clone(), "Przeładowano labwc.", "labwc reloaded.")
    ]
    if id == "reset" [
        if n.confirm [
            let fresh = conf_default()
            fresh.lang = resolve_lang(fresh.clone())
            n.c = fresh
            n.confirm = false
            changed = true
            n.status = tr(n.c.clone(), "Przywrócono ustawienia domyślne.", "Defaults restored.")
        ] else [
            n.confirm = true
        ]
    ]
    if changed [
        conf_save(n.c.clone())
        n.th = hw_theme(n.c.clone())
        n.pending = now
    ]
    end n
]

fun run_settings() [
    if hw_single("settings", 2) == 0 [
        end
    ]
    let c = conf_load()
    let th = hw_theme(c.clone())
    let app = app_new(tr(c.clone(), "Ustawienia", "Settings"), 920, 640)
    if app.backend == "headless" and gui_env("GUI_BACKEND") != "headless" [
        log("brak sesji graficznej")
        end
    ]
    app.set_theme(th.clone())
    app.set_css(hw_css(c.clone(), th.clone()))
    app.set_tick(250)
    let outs: List<OutputInfo> = []
    let s = SState(c, th, 0, -1, outs, vol_get(), vol_muted(), bright_get(), "", "", "", false, "")
    while app.running() [
        let old_theme = s.th.name.clone()
        let old_key = cget(s.c.clone(), "appearance.accent") + cget(s.c.clone(), "appearance.radius") + cget(s.c.clone(), "appearance.font_scale") + cget(s.c.clone(), "appearance.animations")
        for m in app.frame1(settings_view(s.clone())) [
            s = settings_update(s.clone(), m, gui_now_ms())
        ]
        let new_key = cget(s.c.clone(), "appearance.accent") + cget(s.c.clone(), "appearance.radius") + cget(s.c.clone(), "appearance.font_scale") + cget(s.c.clone(), "appearance.animations")
        if s.th.name != old_theme or new_key != old_key [
            app.set_theme(s.th.clone())
            app.set_css(hw_css(s.c.clone(), s.th.clone()))
        ]
        if s.pending >= 0 and gui_now_ms() - s.pending > 600 [
            labwc_apply(s.c.clone(), true)
            s.pending = -1
        ]
    ]
    if s.pending >= 0 [
        labwc_apply(s.c.clone(), true)
    ]
    hw_single_done("settings")
]
