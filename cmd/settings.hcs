fun search_view(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let q = gui_upper(trim(s.query.clone()))
    let rows: List<Element> = []
    let idx = search_index()
    let i = 0
    while i < idx.len() [
        let p = s_split(idx[i].clone(), "|")
        let hay = gui_upper(p[1] + " " + p[2] + " " + p[3])
        if s_find(hay, q.clone()) >= 0 [
            let pg = parse_i(p[0].clone())
            let label = tr(c.clone(), p[1].clone(), p[2].clone())
            let line = row([ column([ text(label).size(14.0), text(page_title(c.clone(), pg)).size(12.0).color(th.p.subtext) ]).spacing(2.0).fill_width(), icon("chevron-right").size(16.0) ]).align_y(1).spacing(12.0)
            let b = button_with(line).on_press("go:" + (pg as Str)).class("ghost").fill_width().padding_xy(16.0, 10.0)
            b.st.ax = 0
            rows.push(b)
        ]
        i = i + 1
    ]
    if rows.len() == 0 [
        rows.push(srow(th.clone(), tr(c.clone(), "Brak wyników", "No results"), "", text("")))
    ]
    end column([ text(tr(c.clone(), "Wyniki wyszukiwania", "Search results")).size(24.0).bold(), group(th.clone(), "", rows) ]).spacing(20.0).fill_width()
]

fun cursor_themes() -> List<Str> [
    let out: List<Str> = []
    let dirs = ["/usr/share/icons", home_dir() + "/.icons", home_dir() + "/.local/share/icons"]
    let i = 0
    while i < dirs.len() [
        if fexists(dirs[i].clone()) [
            let lines = s_split(gui_run("find", [dirs[i].clone(), "-maxdepth", "2", "-type", "d", "-name", "cursors"]), "\n")
            let k = 0
            while k < lines.len() [
                let ln = trim(lines[k].clone())
                if ln != "" [
                    let parts = s_split(ln.clone(), "/")
                    if parts.len() >= 2 [
                        let nm = parts[parts.len() - 2].clone()
                        if not list_has(out.clone(), nm.clone()) [
                            out.push(nm)
                        ]
                    ]
                ]
                k = k + 1
            ]
        ]
        i = i + 1
    ]
    end sort_strs(out)
]

fun settings_view(s: SState) -> Element [
    let th = s.th.clone()
    let items: List<Element> = [ text("HWDE").size(13.0).bold().color(th.p.subtext).padding_4(10.0, 0.0, 8.0, 12.0), text_input(tr(s.c.clone(), "Szukaj ustawień…", "Search settings…"), s.query.clone()).id("q").on_input("q").fill_width() ]
    let i = 0
    while i < page_count() [
        let line = row([ icon(page_icon(i)).size(17.0), text(page_title(s.c.clone(), i)).size(14.0) ]).spacing(12.0).align_y(1)
        let b = button_with(line).on_press("page:" + (i as Str)).class("ghost").fill_width().padding_xy(12.0, 9.0)
        b.st.ax = 0
        if i == s.page [
            b = b.background(with_alpha(th.p.text, 24))
        ]
        items.push(b)
        i = i + 1
    ]
    let side = container(column(items).spacing(2.0).fill_width()).width(fixed(240.0)).fill_height().padding(10.0).background(th.p.surface)
    let page = page_system(s.clone())
    if s.page == 0 [
        page = page_appearance(s.clone())
    ]
    if s.page == 1 [
        page = page_wallpaper(s.clone())
    ]
    if s.page == 2 [
        page = page_panel(s.clone())
    ]
    if s.page == 3 [
        page = page_windows(s.clone())
    ]
    if s.page == 4 [
        page = page_input(s.clone())
    ]
    if s.page == 5 [
        page = page_display(s.clone())
    ]
    if s.page == 6 [
        page = page_notify(s.clone())
    ]
    if s.page == 7 [
        page = page_apps(s.clone())
    ]
    if slen(trim(s.query.clone())) > 0 [
        page = search_view(s.clone())
    ]
    let body = scrollable(container(page).padding(28.0).fill_width()).fill_all()
    end row([ side, body ]).fill_all()
]

!! ---------------------------------------------------------------- aktualizacja
fun conf_without(c: Conf, key: Str) -> Conf [
    let keep: Dict<Str, Str> = dict()
    let all = c.kv.keys()
    let q = 0
    while q < all.len() [
        if all[q] != key [
            keep.insert(all[q].clone(), cget(c.clone(), all[q].clone()))
        ]
        q = q + 1
    ]
    end Conf(keep, c.lang.clone(), c.path.clone())
]

fun next_auto_key(c: Conf) -> Str [
    let n = list_keys(c.clone(), "autostart.").len() + 1
    let name = "autostart.a" + pad3(n)
    while cget(c.clone(), name.clone()) != "" [
        n = n + 1
        name = "autostart.a" + pad3(n)
    ]
    end name
]

fun pad3(n: Int) -> Str [
    if n < 10 [
        end "00" + (n as Str)
    ]
    if n < 100 [
        end "0" + (n as Str)
    ]
    end n as Str
]

fun panel_preset(c: Conf, id: Str) [
    if id == "dock" [
        cset(c, "panel.position", "bottom")
        cset(c, "panel.floating", "1")
        cset(c, "panel.height", "46")
        cset(c, "panel.margin", "8")
        cset(c, "panel.left", "launcher")
        cset(c, "panel.center", "tasks")
        cset(c, "panel.right", "status,clock,power")
    ]
    if id == "minimal" [
        cset(c, "panel.position", "top")
        cset(c, "panel.floating", "0")
        cset(c, "panel.height", "30")
        cset(c, "panel.margin", "0")
        cset(c, "panel.left", "tasks")
        cset(c, "panel.center", "")
        cset(c, "panel.right", "clock,status")
    ]
    if id == "classic" [
        cset(c, "panel.position", "top")
        cset(c, "panel.floating", "1")
        cset(c, "panel.height", "38")
        cset(c, "panel.margin", "6")
        cset(c, "panel.left", "launcher,tasks")
        cset(c, "panel.center", "clock")
        cset(c, "panel.right", "status,power")
    ]
]

fun settings_update(s: SState, m: Message, now: Int) -> SState [
    let n = s.clone()
    n.outputs = outputs_update(n.outputs.clone(), m)
    let changed = false
    let id = m.id.clone()
    if s_starts(id.clone(), "page:") [
        n.page = parse_i(s_sub(id.clone(), 5, slen(id.clone())))
        n.confirm = false
        n.query = ""
    ]
    if s_starts(id.clone(), "go:") [
        n.page = parse_i(s_sub(id.clone(), 3, slen(id.clone())))
        n.query = ""
    ]
    if id == "q" [
        n.query = m.text.clone()
    ]
    if s_starts(id.clone(), "wp:") [
        if wall_preset_apply(n.c, s_sub(id.clone(), 3, slen(id.clone()))) [
            changed = true
        ]
    ]
    if s_starts(id.clone(), "wi:") [
        let wi = parse_i(s_sub(id.clone(), 3, slen(id.clone())))
        if wi >= 0 and wi < n.wall_files.len() [
            cset(n.c, "wallpaper.mode", "image")
            cset(n.c, "wallpaper.image", n.wall_files[wi].clone())
            changed = true
        ]
    ]
    if s_starts(id.clone(), "wgp:") [
        n.wall_page = imax(n.wall_page + parse_i(s_sub(id.clone(), 4, slen(id.clone()))), 0)
        let maxp = imax((n.wall_files.len() + 7) / 8 - 1, 0)
        n.wall_page = imin(n.wall_page, maxp)
    ]
    if id == "wref" [
        n.wall_files = wall_list(n.c.clone())
        n.wall_page = 0
    ]
    if id == "wnext" [
        wall_step(n.c.clone(), "next")
    ]
    if id == "wprev" [
        wall_step(n.c.clone(), "prev")
    ]
    if id == "wrand" [
        wall_step(n.c.clone(), "random")
    ]
    if s_starts(id.clone(), "pp:") [
        panel_preset(n.c, s_sub(id.clone(), 3, slen(id.clone())))
        changed = true
    ]
    if id == "bk" [
        let dst = conf_backup()
        n.backups = conf_backups()
        if dst != "" [
            n.status = tr(n.c.clone(), "Zapisano kopię: ", "Backup saved: ") + dst
        ]
    ]
    if s_starts(id.clone(), "rb:") [
        let bi = parse_i(s_sub(id.clone(), 3, slen(id.clone())))
        if bi >= 0 and bi < n.backups.len() [
            let txt = gui_read_file(n.backups[bi].clone())
            if slen(txt.clone()) > 0 [
                gui_write_file(conf_path(), txt)
                n.c = conf_load()
                n.th = hw_theme(n.c.clone())
                n.pending = now
                n.status = tr(n.c.clone(), "Przywrócono kopię.", "Backup restored.")
            ]
        ]
    ]
    if id == "chk" [
        let hl = hl_path()
        if hl == "" [
            n.status = tr(n.c.clone(), "Brak interpretera hl.", "The hl interpreter was not found.")
        ] else [
            if hw_status(hl, ["check", conf_path()]) == 0 [
                n.status = tr(n.c.clone(), "hwde.conf: składnia poprawna.", "hwde.conf: syntax OK.")
            ] else [
                n.status = tr(n.c.clone(), "hwde.conf: błąd składni (uruchom: hl check hwde.conf).", "hwde.conf: syntax error (run: hl check hwde.conf).")
            ]
        ]
    ]
    if s_starts(id.clone(), "b:") [
        cset_b(n.c, s_sub(id.clone(), 2, slen(id.clone())), m.flag)
        changed = true
    ]
    if s_starts(id.clone(), "s:") [
        let key = s_sub(id.clone(), 2, slen(id.clone()))
        let v = m.num
        if key == "input.pointer_speed" [
            cset(n.c, key, fmt_float(fround(v * 10.0) / 10.0, 1))
        ] else [
            cset(n.c, key, (fround(v) as Int) as Str)
        ]
        changed = true
    ]
    if s_starts(id.clone(), "t:") [
        cset(n.c, s_sub(id.clone(), 2, slen(id.clone())), m.text.clone())
        changed = true
    ]
    if s_starts(id.clone(), "p:") [
        let key2 = s_sub(id.clone(), 2, slen(id.clone()))
        let vals = enum_vals(key2.clone())
        if m.idx >= 0 and m.idx < vals.len() [
            cset(n.c, key2.clone(), vals[m.idx].clone())
            changed = true
            if key2 == "general.language" [
                n.c.lang = resolve_lang(n.c.clone())
            ]
        ]
    ]
    if s_starts(id.clone(), "acc:") [
        cset(n.c, "appearance.accent", s_sub(id.clone(), 4, slen(id.clone())))
        changed = true
    ]
    if s_starts(id.clone(), "ds:") [
        let out = s_sub(id.clone(), 3, slen(id.clone()))
        let vals2 = enum_vals("display.scale")
        if m.idx >= 0 and m.idx < vals2.len() [
            cset(n.c, "display.scale." + out, vals2[m.idx].clone())
            if hw_which("wlr-randr") [
                hw_status("wlr-randr", ["--output", out, "--scale", vals2[m.idx].clone()])
            ]
            changed = true
        ]
    ]
    if id == "vol" [
        n.vol = fround(m.num) as Int
        vol_set(n.vol)
    ]
    if id == "bright" [
        n.bright = fround(m.num) as Int
        bright_set(n.bright)
    ]
    if id == "mute" [
        vol_toggle_mute()
        n.muted = vol_muted()
    ]
    if id == "nk" [
        n.new_key = m.text.clone()
    ]
    if id == "nc" [
        n.new_cmd = m.text.clone()
    ]
    if id == "na" [
        n.new_auto = m.text.clone()
    ]
    if id == "kadd" [
        if trim(n.new_key.clone()) != "" and trim(n.new_cmd.clone()) != "" [
            cset(n.c, "keys." + trim(n.new_key.clone()), trim(n.new_cmd.clone()))
            n.new_key = ""
            n.new_cmd = ""
            changed = true
        ]
    ]
    if s_starts(id.clone(), "kdel:") [
        cset(n.c, s_sub(id.clone(), 5, slen(id.clone())), "")
        changed = true
    ]
    if id == "aadd" [
        if trim(n.new_auto.clone()) != "" [
            let akey = next_auto_key(n.c.clone())
            cset(n.c, akey, trim(n.new_auto.clone()))
            n.new_auto = ""
            changed = true
        ]
    ]
    if s_starts(id.clone(), "adel:") [
        let kk = s_sub(id.clone(), 5, slen(id.clone()))
        n.c = conf_without(n.c.clone(), kk)
        changed = true
    ]
    if id == "edit_conf" [
        conf_save(n.c.clone())
        sh(role_command(n.c.clone(), "editor") + " '" + conf_path() + "'")
    ]
    if id == "edit_css" [
        if gui_file_size(css_path()) < 0 [
            gui_write_file(css_path(), "/* HWDE: wlasny CSS. Przyklad:\nbutton.primary { border-radius: 999px; }\n*/\n")
        ]
        sh(role_command(n.c.clone(), "editor") + " '" + css_path() + "'")
    ]
    if id == "reload" [
        labwc_apply(n.c.clone(), true)
        n.status = tr(n.c.clone(), "Przeładowano labwc.", "labwc reloaded.")
    ]
    if id == "reset" [
        if n.confirm [
            let fresh = conf_default()
            fresh.lang = resolve_lang(fresh.clone())
            n.c = fresh
            n.confirm = false
            changed = true
            n.status = tr(n.c.clone(), "Przywrócono ustawienia domyślne.", "Defaults restored.")
        ] else [
            n.confirm = true
        ]
    ]
    if changed [
        conf_save(n.c.clone())
        n.th = hw_theme(n.c.clone())
        n.pending = now
    ]
    end n
]

fun run_settings() [
    if hw_single("settings", 2) == 0 [
        end
    ]
    let c = conf_load()
    let th = hw_theme(c.clone())
    let app = app_new(tr(c.clone(), "Ustawienia", "Settings"), 920, 640)
    if app.backend == "headless" and gui_env("GUI_BACKEND") != "headless" [
        log("brak sesji graficznej")
        end
    ]
    app.set_theme(th.clone())
    app.set_css(hw_css(c.clone(), th.clone()))
    app.set_tick(250)
    let outs: List<OutputInfo> = []
    let s = SState(c, th, 0, -1, outs, vol_get(), vol_muted(), bright_get(), "", "", "", false, "", "", wall_list(c.clone()), 0, cursor_themes(), conf_backups())
    while app.running() [
        let old_theme = s.th.name.clone()
        let old_key = cget(s.c.clone(), "appearance.accent") + cget(s.c.clone(), "appearance.radius") + cget(s.c.clone(), "appearance.font_scale") + cget(s.c.clone(), "appearance.animations")
        for m in app.frame1(settings_view(s.clone())) [
            s = settings_update(s.clone(), m, gui_now_ms())
        ]
        let new_key = cget(s.c.clone(), "appearance.accent") + cget(s.c.clone(), "appearance.radius") + cget(s.c.clone(), "appearance.font_scale") + cget(s.c.clone(), "appearance.animations")
        if s.th.name != old_theme or new_key != old_key [
            app.set_theme(s.th.clone())
            app.set_css(hw_css(s.c.clone(), s.th.clone()))
        ]
        if s.pending >= 0 and gui_now_ms() - s.pending > 600 [
            labwc_apply(s.c.clone(), true)
            s.pending = -1
        ]
    ]
    if s.pending >= 0 [
        labwc_apply(s.c.clone(), true)
    ]
    hw_single_done("settings")
]

!! pomocnicze (debug/dokumentacja): GUI_BACKEND=headless hwde settings-shot <strona 0-8> <plik.png> [szukaj]
fun run_settings_shot(page: Int, file: Str, query: Str) [
    let c = conf_load()
    let th = hw_theme(c.clone())
    let app = app_new(tr(c.clone(), "Ustawienia", "Settings"), 920, 900)
    app.set_theme(th.clone())
    app.set_css(hw_css(c.clone(), th.clone()))
    let outs: List<OutputInfo> = []
    let s = SState(c, th, page, -1, outs, -1, false, -1, "", "", "", false, "", query, wall_list(c.clone()), 0, cursor_themes(), conf_backups())
    let i = 0
    while i < 4 [
        for m in app.frame1(settings_view(s.clone())) [
            s = settings_update(s.clone(), m, gui_now_ms())
        ]
        i = i + 1
    ]
    let ids = app.window_ids()
    if ids.len() > 0 [
        gui_screenshot(ids[0], file)
    ]
]
