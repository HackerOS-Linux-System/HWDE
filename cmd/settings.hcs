    let c = s.c.clone()
    let th = s.th.clone()
    let cur = cget(c.clone(), "appearance.accent")
    let sw = row([ swatch("neutral", tr(c.clone(), "Neutralny", "Neutral"), cur.clone(), th.dark), swatch("blue", tr(c.clone(), "Niebieski", "Blue"), cur.clone(), th.dark), swatch("teal", tr(c.clone(), "Morski", "Teal"), cur.clone(), th.dark), swatch("green", tr(c.clone(), "Zielony", "Green"), cur.clone(), th.dark), swatch("yellow", tr(c.clone(), "Żółty", "Yellow"), cur.clone(), th.dark), swatch("orange", tr(c.clone(), "Pomarańczowy", "Orange"), cur.clone(), th.dark), swatch("red", tr(c.clone(), "Czerwony", "Red"), cur.clone(), th.dark), swatch("pink", tr(c.clone(), "Różowy", "Pink"), cur.clone(), th.dark), swatch("purple", tr(c.clone(), "Fioletowy", "Purple"), cur.clone(), th.dark) ]).spacing(2.0).align_y(1)
    let look: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Motyw", "Theme"), tr(c.clone(), "Szaro-czarny ciemny albo biało-jasnoszary jasny", "Gray-black dark or white/light-gray light"), "appearance.mode"), srow(th.clone(), tr(c.clone(), "Kolor akcentu", "Accent color"), tr(c.clone(), "Neutralny = biel/czerń zależnie od motywu", "Neutral = white/black depending on the theme"), sw), r_text(s.clone(), tr(c.clone(), "Własny akcent", "Custom accent"), tr(c.clone(), "np. #ff7a00 (nadpisuje wybór powyżej)", "e.g. #ff7a00 (overrides the choice above)"), "appearance.accent", "neutral"), r_slider(s.clone(), tr(c.clone(), "Zaokrąglenie", "Corner radius"), "", "appearance.radius", 0.0, 24.0, " px"), r_slider(s.clone(), tr(c.clone(), "Skala czcionki", "Font scale"), "", "appearance.font_scale", 80.0, 150.0, "%"), r_toggle(s.clone(), tr(c.clone(), "Animacje", "Animations"), "", "appearance.animations") ]
    let wall: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Rodzaj tła", "Background type"), "", "wallpaper.mode"), r_text(s.clone(), tr(c.clone(), "Kolor 1", "Color 1"), tr(c.clone(), "puste = zgodnie z motywem, np. #2a2a2f", "empty = follow theme, e.g. #2a2a2f"), "wallpaper.color1", "#2a2a2f"), r_text(s.clone(), tr(c.clone(), "Kolor 2", "Color 2"), tr(c.clone(), "koniec gradientu", "gradient end"), "wallpaper.color2", "#0a0a0b"), r_slider(s.clone(), tr(c.clone(), "Kąt gradientu", "Gradient angle"), "", "wallpaper.angle", 0.0, 360.0, "°"), r_text(s.clone(), tr(c.clone(), "Plik obrazu", "Image file"), tr(c.clone(), "wymaga programu swaybg", "requires swaybg"), "wallpaper.image", "~/Pictures/tapeta.png") ]
    end column([ page_head(s.clone(), 0), group(th.clone(), tr(c.clone(), "Motyw", "Theme"), look), group(th.clone(), tr(c.clone(), "Tapeta", "Wallpaper"), wall) ]).spacing(20.0).fill_width()
]

