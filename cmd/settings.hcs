fun list_keys(c: Conf, prefix: Str) -> List<Str> [
    let keys = c.kv.keys()
    let names: List<Str> = []
    let i = 0
    while i < keys.len() [
        if s_starts(keys[i].clone(), prefix.clone()) [
            names.push(keys[i].clone())
        ]
        i = i + 1
    ]
    end sort_strs(names)
]

fun page_apps(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let apps: List<Element> = [ r_text(s.clone(), tr(c.clone(), "Terminal", "Terminal"), tr(c.clone(), "puste = wykryj automatycznie: ", "empty = autodetect: ") + role_command(conf_default(), "terminal"), "apps.terminal", role_command(conf_default(), "terminal")), r_text(s.clone(), tr(c.clone(), "Przeglądarka", "Browser"), "", "apps.browser", role_command(conf_default(), "browser")), r_text(s.clone(), tr(c.clone(), "Menedżer plików", "File manager"), "", "apps.files", role_command(conf_default(), "files")), r_text(s.clone(), tr(c.clone(), "Edytor", "Editor"), "", "apps.editor", role_command(conf_default(), "editor")) ]
    let rows: List<Element> = []
    let ks = list_keys(c.clone(), "keys.")
    let i = 0
    while i < ks.len() [
        let v = cget(c.clone(), ks[i].clone())
        if v != "" [
            let del = button("").with_icon("trash").on_press("kdel:" + ks[i]).class("ghost icon")
            let line = row([ text(key_of(ks[i].clone())).size(13.0).bold().width(fixed(190.0)), text_input("exec:… / action:…", v).id(ks[i].clone()).on_input("t:" + ks[i]).fill_width(), del ]).spacing(10.0).align_y(1).padding_xy(16.0, 6.0).fill_width()
            rows.push(line)
        ]
        i = i + 1
    ]
    let add = row([ text_input(tr(c.clone(), "Skrót, np. W-t", "Shortcut, e.g. W-t"), s.new_key.clone()).id("new_key").on_input("nk").width(fixed(190.0)), text_input(tr(c.clone(), "exec:polecenie lub action:Nazwa", "exec:command or action:Name"), s.new_cmd.clone()).id("new_cmd").on_input("nc").on_submit("kadd").fill_width(), button(tr(c.clone(), "Dodaj", "Add")).with_icon("plus").on_press("kadd").class("primary") ]).spacing(10.0).align_y(1).padding_xy(16.0, 10.0).fill_width()
    rows.push(add)
    let auto: List<Element> = []
    let autos = list_keys(c.clone(), "autostart.")
    let k = 0
    while k < autos.len() [
        let del2 = button("").with_icon("trash").on_press("adel:" + autos[k]).class("ghost icon")
        auto.push(row([ text_input("", cget(c.clone(), autos[k].clone())).id(autos[k].clone()).on_input("t:" + autos[k]).fill_width(), del2 ]).spacing(10.0).align_y(1).padding_xy(16.0, 6.0).fill_width())
        k = k + 1
    ]
    auto.push(row([ text_input(tr(c.clone(), "Polecenie uruchamiane przy logowaniu", "Command to run at login"), s.new_auto.clone()).id("new_auto").on_input("na").on_submit("aadd").fill_width(), button(tr(c.clone(), "Dodaj", "Add")).with_icon("plus").on_press("aadd").class("primary") ]).spacing(10.0).align_y(1).padding_xy(16.0, 10.0).fill_width())
    end column([ page_head(s.clone(), 7), group(th.clone(), tr(c.clone(), "Aplikacje domyślne", "Default apps"), apps), group(th.clone(), tr(c.clone(), "Skróty klawiszowe (W = Super, A = Alt, C = Ctrl, S = Shift)", "Keyboard shortcuts (W = Super, A = Alt, C = Ctrl, S = Shift)"), rows), group(th.clone(), tr(c.clone(), "Autostart", "Autostart"), auto) ]).spacing(20.0).fill_width()
]

fun hl_version_line() -> Str [
    let hl = hl_path()
    if hl == "" [
        end ""
    ]
    let t = out_of(hl, ["version"])
    let p = s_split(t, "\n")
    end trim(p[0].clone())
]

fun page_system(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let kern = out_of("uname", ["-sr"])
    let lw = "labwc"
    if hw_which("labwc") [
        lw = out_of("labwc", ["--version"])
    ]
    let hlv = hl_version_line()
    let hl_show = tr(c.clone(), "nie znaleziono — używany uproszczony czytnik konfiguracji", "not found — using the simplified config reader")
    if hlv != "" [
        hl_show = hlv
    ]
    let a: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Język", "Language"), "", "general.language") ]
    let reset_label = tr(c.clone(), "Przywróć domyślne", "Reset to defaults")
    if s.confirm [
        reset_label = tr(c.clone(), "Na pewno? Kliknij ponownie", "Sure? Click again")
    ]
    let acts1 = row([ button(tr(c.clone(), "Edytuj hwde.conf", "Edit hwde.conf")).with_icon("pencil").on_press("edit_conf"), button(tr(c.clone(), "Sprawdź składnię", "Check syntax")).with_icon("check").on_press("chk"), button(tr(c.clone(), "Edytuj custom.css", "Edit custom.css")).with_icon("pencil").on_press("edit_css") ]).spacing(10.0)
    let acts2 = row([ button(tr(c.clone(), "Przeładuj labwc", "Reload labwc")).with_icon("refresh-cw").on_press("reload"), button(reset_label).with_icon("trash").class("danger").on_press("reset") ]).spacing(10.0)
    let acts = column([ acts1, acts2 ]).spacing(10.0)
    let bk: List<Element> = [ srow(th.clone(), tr(c.clone(), "Kopia zapasowa", "Backup"), conf_backup_dir(), button(tr(c.clone(), "Utwórz kopię", "Create backup")).with_icon("download").on_press("bk")) ]
    let i = 0
    while i < s.backups.len() [
        let name = wall_base(s.backups[i].clone())
        bk.push(srow(th.clone(), name, "", button(tr(c.clone(), "Przywróć", "Restore")).on_press("rb:" + (i as Str))))
        i = i + 1
    ]
    let b: List<Element> = [ srow(th.clone(), "HWDE", tr(c.clone(), "HackerOS Wayland Desktop Environment", "HackerOS Wayland Desktop Environment"), text("0.2").bold()), srow(th.clone(), "Hacker Lang", tr(c.clone(), "interpreter wykonujący hwde.conf", "interpreter that runs hwde.conf"), text(hl_show).size(13.0)), srow(th.clone(), tr(c.clone(), "Kompozytor", "Compositor"), "", text(lw.clone()).size(13.0)), srow(th.clone(), tr(c.clone(), "Jądro", "Kernel"), "", text(kern.clone()).size(13.0)), srow(th.clone(), tr(c.clone(), "Konfiguracja", "Configuration"), conf_path(), text("")) ]
    end column([ page_head(s.clone(), 8), group(th.clone(), tr(c.clone(), "Ogólne", "General"), a), group(th.clone(), tr(c.clone(), "Kopie zapasowe", "Backups"), bk), group(th.clone(), tr(c.clone(), "O systemie", "About"), b), acts, text(s.status.clone()).size(12.0).color(th.p.subtext) ]).spacing(20.0).fill_width()
]

