get <bit:gui>
include <sys>
include <conf>
include <sysinfo>
include <labwc>

!! ============================================================================
!! Ustawienia HWDE - jedyna wbudowana aplikacja. Zmienia hwde.conf; powloka i
!! sama aplikacja przeladowuja sie na zywo, a labwc dostaje nowe rc.xml/themerc.
!! ============================================================================

struct SState [
    c: Conf,
    th: Theme,
    page: Int,
    pending: Int,
    outputs: List<OutputInfo>,
    vol: Int,
    muted: Bool,
    bright: Int,
    new_key: Str,
    new_cmd: Str,
    new_auto: Str,
    confirm: Bool,
    status: Str
]

fun page_count() -> Int [
    end 8
]

fun page_title(c: Conf, i: Int) -> Str [
    if i == 0 [
        end tr(c.clone(), "Wygląd", "Appearance")
    ]
    if i == 1 [
        end tr(c.clone(), "Panel", "Panel")
    ]
    if i == 2 [
        end tr(c.clone(), "Okna", "Windows")
    ]
    if i == 3 [
        end tr(c.clone(), "Wejście", "Input")
    ]
    if i == 4 [
        end tr(c.clone(), "Ekran i dźwięk", "Display & sound")
    ]
    if i == 5 [
        end tr(c.clone(), "Powiadomienia i blokada", "Notifications & lock")
    ]
    if i == 6 [
        end tr(c.clone(), "Skróty i aplikacje", "Shortcuts & apps")
    ]
    end tr(c.clone(), "System", "System")
]

fun page_icon(i: Int) -> Str [
    let ic = ["image", "layout-grid", "maximize", "sliders-horizontal", "monitor", "bell", "terminal", "info"]
    end ic[iclamp(i, 0, 7)].clone()
]

!! ---------------------------------------------------------------- wartosci wyliczeniowe
fun enum_vals(key: Str) -> List<Str> [
    if key == "appearance.mode" [
        end ["dark", "light", "auto"]
    ]
    if key == "panel.position" [
        end ["top", "bottom"]
    ]
    if key == "panel.clock" [
        end ["24h", "12h"]
    ]
    if key == "wallpaper.mode" [
        end ["gradient", "color", "image"]
    ]
    if key == "windows.titlebar" [
        end ["icon:iconify,max,close", ":iconify,max,close", "close,iconify,max:", "icon:close"]
    ]
    if key == "input.layout" [
        end ["pl", "us", "gb", "de", "fr", "es", "it", "pt", "br", "cz", "sk", "ua", "ru", "se", "no", "dk", "fi", "hu", "ro", "tr"]
    ]
    if key == "input.accel" [
        end ["adaptive", "flat"]
    ]
    if key == "general.language" [
        end ["auto", "pl", "en"]
    ]
    if key == "lock.timeout" or key == "lock.screen_off" [
        end ["0", "1", "2", "5", "10", "15", "30", "60"]
    ]
    if key == "display.scale" [
        end ["1", "1.25", "1.5", "1.75", "2"]
    ]
    end []
]

fun enum_label(c: Conf, key: Str, v: Str) -> Str [
    if key == "appearance.mode" [
        if v == "dark" [
            end tr(c.clone(), "Ciemny", "Dark")
        ]
        if v == "light" [
            end tr(c.clone(), "Jasny", "Light")
        ]
        end tr(c.clone(), "Automatyczny (dzień/noc)", "Automatic (day/night)")
    ]
    if key == "panel.position" [
        if v == "top" [
            end tr(c.clone(), "Góra", "Top")
        ]
        end tr(c.clone(), "Dół", "Bottom")
    ]
    if key == "panel.clock" [
        if v == "24h" [
            end "24 h"
        ]
        end "12 h (AM/PM)"
    ]
    if key == "wallpaper.mode" [
        if v == "gradient" [
            end tr(c.clone(), "Gradient", "Gradient")
        ]
        if v == "color" [
            end tr(c.clone(), "Jeden kolor", "Solid color")
        ]
        end tr(c.clone(), "Obraz (swaybg)", "Image (swaybg)")
    ]
    if key == "windows.titlebar" [
        if v == "icon:iconify,max,close" [
            end tr(c.clone(), "Klasyczny", "Classic")
        ]
        if v == ":iconify,max,close" [
            end tr(c.clone(), "Bez ikony", "No icon")
        ]
        if v == "close,iconify,max:" [
            end tr(c.clone(), "Przyciski po lewej", "Buttons on the left")
        ]
        end tr(c.clone(), "Tylko zamknij", "Close only")
    ]
    if key == "input.accel" [
        if v == "adaptive" [
            end tr(c.clone(), "Adaptacyjne", "Adaptive")
        ]
        end tr(c.clone(), "Płaskie", "Flat")
    ]
    if key == "general.language" [
        if v == "auto" [
            end tr(c.clone(), "Automatycznie", "Automatic")
        ]
        if v == "pl" [
            end "Polski"
        ]
        end "English"
    ]
    if key == "lock.timeout" or key == "lock.screen_off" [
        if v == "0" [
            end tr(c.clone(), "Wyłączone", "Off")
        ]
        end v + " min"
    ]
    if key == "display.scale" [
        end (parse_f(v) * 100.0) as Int as Str + "%"
    ]
    end v
]

fun enum_labels(c: Conf, key: Str) -> List<Str> [
    let vals = enum_vals(key)
    let out: List<Str> = []
    let i = 0
    while i < vals.len() [
        out.push(enum_label(c.clone(), key, vals[i].clone()))
        i = i + 1
    ]
    end out
]

fun enum_index(key: Str, v: Str) -> Int [
    let vals = enum_vals(key)
    let i = 0
    while i < vals.len() [
        if vals[i] == v [
            end i
        ]
        i = i + 1
    ]
    end -1
]

!! ---------------------------------------------------------------- klocki widoku
fun group(th: Theme, title: Str, rows: List<Element>) -> Element [
    let kids: List<Element> = []
    let i = 0
    while i < rows.len() [
        if i > 0 [
            kids.push(rule())
        ]
        kids.push(rows[i].clone())
        i = i + 1
    ]
    let box = container(column(kids).spacing(0.0).fill_width())
    let card = box.background(th.p.surface).radius(th.radius_lg).border(1.0, th.p.border).fill_width()
    if title == "" [
        end card
    ]
    end column([ text(title).size(12.0).bold().color(th.p.subtext).padding_4(0.0, 0.0, 0.0, 4.0), card ]).spacing(8.0).fill_width()
]

fun srow(th: Theme, label: Str, hint: Str, control: Element) -> Element [
    let kids: List<Element> = [ text(label).size(14.0) ]
    if hint != "" [
        kids.push(text(hint).size(12.0).color(th.p.subtext))
    ]
    end row([ column(kids).spacing(2.0).fill_width(), control ]).align_y(1).spacing(16.0).padding_xy(16.0, 12.0).fill_width()
]

fun r_toggle(s: SState, label: Str, hint: Str, key: Str) -> Element [
    end srow(s.th.clone(), label, hint, toggler("", cget_b(s.c.clone(), key)).on_toggle("b:" + key))
]

fun r_slider(s: SState, label: Str, hint: Str, key: Str, lo: Float, hi: Float, suffix: Str) -> Element [
    let v = cget_f(s.c.clone(), key)
    let sl = slider(lo, hi, fclamp(v, lo, hi)).on_change("s:" + key).width(fixed(190.0))
    let shown = fmt_float(v, 0)
    if hi - lo <= 4.0 [
        shown = fmt_float(v, 2)
    ]
    end srow(s.th.clone(), label, hint, row([ sl, text(shown + suffix).size(13.0).width(fixed(52.0)).text_align(2) ]).spacing(10.0).align_y(1))
]

fun r_text(s: SState, label: Str, hint: Str, key: Str, ph: Str) -> Element [
    end srow(s.th.clone(), label, hint, text_input(ph, cget(s.c.clone(), key)).id(key).on_input("t:" + key).width(fixed(240.0)))
]

fun r_pick(s: SState, label: Str, hint: Str, key: Str) -> Element [
    let cur = cget(s.c.clone(), key)
    let labels = enum_labels(s.c.clone(), key)
    let idx = enum_index(key, cur)
    let shown = cur
    if idx >= 0 [
        shown = labels[idx].clone()
    ]
    end srow(s.th.clone(), label, hint, pick_list(labels, shown).on_select("p:" + key).width(fixed(240.0)))
]

fun page_head(s: SState, i: Int) -> Element [
    end text(page_title(s.c.clone(), i)).size(24.0).bold()
]

!! ---------------------------------------------------------------- strony
fun swatch(name: Str, label: Str, cur: Str, dark: Bool) -> Element [
    let col = parse_color(accent_hex(name.clone(), dark))
    let ring = 0
    let bw = 0.0
    if cur == name [
        bw = 2.5
        ring = parse_color("#808080")
    ]
    let dot = container(space()).size_px(22.0, 22.0).radius(999.0).background(col).border(bw, ring)
    end tooltip(button_with(dot).on_press("acc:" + name).class("ghost").padding(5.0).radius(999.0), label)
]

