    end column([ page_head(s.clone(), 3), group(th.clone(), tr(c.clone(), "Klawiatura", "Keyboard"), a), group(th.clone(), tr(c.clone(), "Mysz i touchpad", "Mouse & touchpad"), b) ]).spacing(20.0).fill_width()
]

fun page_display(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let kids: List<Element> = [ page_head(s.clone(), 4) ]
    let mons: List<Element> = []
    let i = 0
    while i < s.outputs.len() [
        let o = s.outputs[i].clone()
        let key = "display.scale." + o.name
        let cur = cget(c.clone(), key)
        if cur == "" [
            cur = fmt_float(o.scale as Float, 0)
        ]
        let labels = enum_labels(c.clone(), "display.scale")
        let idx = enum_index("display.scale", cur)
        let shown = labels[1].clone()
        if idx >= 0 [
            shown = labels[idx].clone()
        ]
        let ctl = pick_list(labels, shown).on_select("ds:" + o.name).width(fixed(140.0))
        mons.push(srow(th.clone(), o.name.clone(), (o.w as Str) + " × " + (o.h as Str), ctl))
        i = i + 1
    ]
    if mons.len() == 0 [
        mons.push(srow(th.clone(), tr(c.clone(), "Brak danych o monitorach", "No monitor data"), "", text("")))
    ]
    if hw_which("wlr-randr") [
        kids.push(group(th.clone(), tr(c.clone(), "Monitory (skala przez wlr-randr)", "Monitors (scale via wlr-randr)"), mons))
    ] else [
        kids.push(group(th.clone(), tr(c.clone(), "Monitory", "Monitors"), [ srow(th.clone(), tr(c.clone(), "Zainstaluj wlr-randr, aby zmieniać skalę", "Install wlr-randr to change the scale"), "", text("")) ]))
    ]
    let snd: List<Element> = []
    if s.vol >= 0 [
        let sl = slider(0.0, 100.0, fclamp(s.vol as Float, 0.0, 100.0)).on_change("vol").width(fixed(190.0))
        snd.push(srow(th.clone(), tr(c.clone(), "Głośność", "Volume"), "", row([ sl, text((s.vol as Str) + "%").size(13.0).width(fixed(52.0)).text_align(2) ]).spacing(10.0).align_y(1)))
        snd.push(srow(th.clone(), tr(c.clone(), "Wycisz", "Mute"), "", toggler("", s.muted).on_toggle("mute")))
    ]
    if s.bright >= 0 [
        let sl2 = slider(1.0, 100.0, fclamp(s.bright as Float, 1.0, 100.0)).on_change("bright").width(fixed(190.0))
        snd.push(srow(th.clone(), tr(c.clone(), "Jasność", "Brightness"), "", row([ sl2, text((s.bright as Str) + "%").size(13.0).width(fixed(52.0)).text_align(2) ]).spacing(10.0).align_y(1)))
    ]
    if snd.len() == 0 [
        snd.push(srow(th.clone(), tr(c.clone(), "Nie wykryto sterowania dźwiękiem ani jasnością", "No audio or brightness control detected"), tr(c.clone(), "Potrzebne: wpctl/pactl, brightnessctl", "Needs: wpctl/pactl, brightnessctl"), text("")))
    ]
    kids.push(group(th.clone(), tr(c.clone(), "Dźwięk i jasność", "Sound & brightness"), snd))
    end column(kids).spacing(20.0).fill_width()
]

