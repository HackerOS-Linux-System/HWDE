get <bit:gui>
include <sys>
include <conf>
include <sysinfo>
include <labwc>
include <wallpaper>

!! ============================================================================
!! Ustawienia HWDE - jedyna wbudowana aplikacja. Zmienia hwde.conf; powloka i
!! sama aplikacja przeladowuja sie na zywo, a labwc dostaje nowe rc.xml/themerc.
!! ============================================================================

struct SState [
    c: Conf,
    th: Theme,
    page: Int,
    pending: Int,
    outputs: List<OutputInfo>,
    vol: Int,
    muted: Bool,
    bright: Int,
    new_key: Str,
    new_cmd: Str,
    new_auto: Str,
    confirm: Bool,
    status: Str,
    query: Str,
    wall_files: List<Str>,
    wall_page: Int,
    cursors: List<Str>,
    backups: List<Str>
]

fun page_count() -> Int [
    end 9
]

fun page_title(c: Conf, i: Int) -> Str [
    if i == 0 [
        end tr(c.clone(), "Wygląd", "Appearance")
    ]
    if i == 1 [
        end tr(c.clone(), "Tapety", "Wallpapers")
    ]
    if i == 2 [
        end tr(c.clone(), "Panel", "Panel")
    ]
    if i == 3 [
        end tr(c.clone(), "Okna", "Windows")
    ]
    if i == 4 [
        end tr(c.clone(), "Wejście", "Input")
    ]
    if i == 5 [
        end tr(c.clone(), "Ekran i dźwięk", "Display & sound")
    ]
    if i == 6 [
        end tr(c.clone(), "Powiadomienia i blokada", "Notifications & lock")
    ]
    if i == 7 [
        end tr(c.clone(), "Skróty i aplikacje", "Shortcuts & apps")
    ]
    end tr(c.clone(), "System", "System")
]

fun page_icon(i: Int) -> Str [
    let ic = ["sun", "image", "layout-grid", "maximize", "sliders-horizontal", "monitor", "bell", "terminal", "info"]
    end ic[iclamp(i, 0, 8)].clone()
]

!! ---------------------------------------------------------------- wartosci wyliczeniowe
fun enum_vals(key: Str) -> List<Str> [
    if key == "appearance.mode" [
        end ["dark", "light", "auto"]
    ]
    if key == "panel.position" [
        end ["top", "bottom"]
    ]
    if key == "panel.clock" [
        end ["24h", "12h"]
    ]
    if key == "wallpaper.mode" [
        end ["gradient", "color", "image", "slideshow"]
    ]
    if key == "wallpaper.fit" [
        end ["fill", "fit", "stretch", "center", "tile"]
    ]
    if key == "wallpaper.order" [
        end ["random", "sequential"]
    ]
    if key == "wallpaper.interval" [
        end ["1", "5", "10", "15", "30", "60", "120"]
    ]
    if key == "windows.titlebar" [
        end ["icon:iconify,max,close", ":iconify,max,close", "close,iconify,max:", "icon:close"]
    ]
    if key == "input.layout" [
        end ["pl", "us", "gb", "de", "fr", "es", "it", "pt", "br", "cz", "sk", "ua", "ru", "se", "no", "dk", "fi", "hu", "ro", "tr"]
    ]
    if key == "input.accel" [
        end ["adaptive", "flat"]
    ]
    if key == "general.language" [
        end ["auto", "pl", "en"]
    ]
    if key == "lock.timeout" or key == "lock.screen_off" [
        end ["0", "1", "2", "5", "10", "15", "30", "60"]
    ]
    if key == "display.scale" [
        end ["1", "1.25", "1.5", "1.75", "2"]
    ]
    end []
]

fun enum_label(c: Conf, key: Str, v: Str) -> Str [
    if key == "appearance.mode" [
        if v == "dark" [
            end tr(c.clone(), "Ciemny", "Dark")
        ]
        if v == "light" [
            end tr(c.clone(), "Jasny", "Light")
        ]
        end tr(c.clone(), "Automatyczny (dzień/noc)", "Automatic (day/night)")
    ]
    if key == "panel.position" [
        if v == "top" [
            end tr(c.clone(), "Góra", "Top")
        ]
        end tr(c.clone(), "Dół", "Bottom")
    ]
    if key == "panel.clock" [
        if v == "24h" [
            end "24 h"
        ]
        end "12 h (AM/PM)"
    ]
    if key == "wallpaper.mode" [
        if v == "gradient" [
            end tr(c.clone(), "Gradient", "Gradient")
        ]
        if v == "color" [
            end tr(c.clone(), "Jeden kolor", "Solid color")
        ]
        if v == "image" [
            end tr(c.clone(), "Obraz (swaybg)", "Image (swaybg)")
        ]
        end tr(c.clone(), "Pokaz slajdów", "Slideshow")
    ]
    if key == "wallpaper.fit" [
        if v == "fill" [
            end tr(c.clone(), "Wypełnij (przytnij)", "Fill (crop)")
        ]
        if v == "fit" [
            end tr(c.clone(), "Dopasuj (z paskami)", "Fit (letterbox)")
        ]
        if v == "stretch" [
            end tr(c.clone(), "Rozciągnij", "Stretch")
        ]
        if v == "center" [
            end tr(c.clone(), "Wyśrodkuj", "Center")
        ]
        end tr(c.clone(), "Kafelki", "Tile")
    ]
    if key == "wallpaper.order" [
        if v == "random" [
            end tr(c.clone(), "Losowo", "Random")
        ]
        end tr(c.clone(), "Po kolei", "In order")
    ]
    if key == "wallpaper.interval" [
        end v + " min"
    ]
    if key == "windows.titlebar" [
        if v == "icon:iconify,max,close" [
            end tr(c.clone(), "Klasyczny", "Classic")
        ]
        if v == ":iconify,max,close" [
            end tr(c.clone(), "Bez ikony", "No icon")
        ]
        if v == "close,iconify,max:" [
            end tr(c.clone(), "Przyciski po lewej", "Buttons on the left")
        ]
        end tr(c.clone(), "Tylko zamknij", "Close only")
    ]
    if key == "input.accel" [
        if v == "adaptive" [
            end tr(c.clone(), "Adaptacyjne", "Adaptive")
        ]
        end tr(c.clone(), "Płaskie", "Flat")
    ]
    if key == "general.language" [
        if v == "auto" [
            end tr(c.clone(), "Automatycznie", "Automatic")
        ]
        if v == "pl" [
            end "Polski"
        ]
        end "English"
    ]
    if key == "lock.timeout" or key == "lock.screen_off" [
        if v == "0" [
            end tr(c.clone(), "Wyłączone", "Off")
        ]
        end v + " min"
    ]
    if key == "display.scale" [
        end (parse_f(v) * 100.0) as Int as Str + "%"
    ]
    end v
]

fun enum_labels(c: Conf, key: Str) -> List<Str> [
    let vals = enum_vals(key)
    let out: List<Str> = []
    let i = 0
    while i < vals.len() [
        out.push(enum_label(c.clone(), key, vals[i].clone()))
        i = i + 1
    ]
    end out
]

fun enum_index(key: Str, v: Str) -> Int [
    let vals = enum_vals(key)
    let i = 0
    while i < vals.len() [
        if vals[i] == v [
            end i
        ]
        i = i + 1
    ]
    end -1
]

!! ---------------------------------------------------------------- klocki widoku
fun group(th: Theme, title: Str, rows: List<Element>) -> Element [
    let kids: List<Element> = []
    let i = 0
    while i < rows.len() [
        if i > 0 [
            kids.push(rule())
        ]
        kids.push(rows[i].clone())
        i = i + 1
    ]
    let box = container(column(kids).spacing(0.0).fill_width())
    let card = box.background(th.p.surface).radius(th.radius_lg).border(1.0, th.p.border).fill_width()
    if title == "" [
        end card
    ]
    end column([ text(title).size(12.0).bold().color(th.p.subtext).padding_4(0.0, 0.0, 0.0, 4.0), card ]).spacing(8.0).fill_width()
]

fun srow(th: Theme, label: Str, hint: Str, control: Element) -> Element [
    let kids: List<Element> = [ text(label).size(14.0) ]
    if hint != "" [
        kids.push(text(hint).size(12.0).color(th.p.subtext))
    ]
    end row([ column(kids).spacing(2.0).fill_width(), control ]).align_y(1).spacing(16.0).padding_xy(16.0, 12.0).fill_width()
]

fun r_toggle(s: SState, label: Str, hint: Str, key: Str) -> Element [
    end srow(s.th.clone(), label, hint, toggler("", cget_b(s.c.clone(), key)).on_toggle("b:" + key))
]

fun r_slider(s: SState, label: Str, hint: Str, key: Str, lo: Float, hi: Float, suffix: Str) -> Element [
    let v = cget_f(s.c.clone(), key)
    let sl = slider(lo, hi, fclamp(v, lo, hi)).on_change("s:" + key).width(fixed(190.0))
    let shown = fmt_float(v, 0)
    if hi - lo <= 4.0 [
        shown = fmt_float(v, 2)
    ]
    end srow(s.th.clone(), label, hint, row([ sl, text(shown + suffix).size(13.0).width(fixed(52.0)).text_align(2) ]).spacing(10.0).align_y(1))
]

fun r_text(s: SState, label: Str, hint: Str, key: Str, ph: Str) -> Element [
    end srow(s.th.clone(), label, hint, text_input(ph, cget(s.c.clone(), key)).id(key).on_input("t:" + key).width(fixed(240.0)))
]

fun r_pick(s: SState, label: Str, hint: Str, key: Str) -> Element [
    let cur = cget(s.c.clone(), key)
    let labels = enum_labels(s.c.clone(), key)
    let idx = enum_index(key, cur)
    let shown = cur
    if idx >= 0 [
        shown = labels[idx].clone()
    ]
    end srow(s.th.clone(), label, hint, pick_list(labels, shown).on_select("p:" + key).width(fixed(240.0)))
]

fun page_head(s: SState, i: Int) -> Element [
    end text(page_title(s.c.clone(), i)).size(24.0).bold()
]

!! ---------------------------------------------------------------- strony
fun swatch(name: Str, label: Str, cur: Str, dark: Bool) -> Element [
    let col = parse_color(accent_hex(name.clone(), dark))
    let ring = 0
    let bw = 0.0
    if cur == name [
        bw = 2.5
        ring = parse_color("#808080")
    ]
    let dot = container(space()).size_px(22.0, 22.0).radius(999.0).background(col).border(bw, ring)
    end tooltip(button_with(dot).on_press("acc:" + name).class("ghost").padding(5.0).radius(999.0), label)
]

fun page_appearance(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let cur = cget(c.clone(), "appearance.accent")
    let sw = row([ swatch("neutral", tr(c.clone(), "Neutralny", "Neutral"), cur.clone(), th.dark), swatch("blue", tr(c.clone(), "Niebieski", "Blue"), cur.clone(), th.dark), swatch("teal", tr(c.clone(), "Morski", "Teal"), cur.clone(), th.dark), swatch("green", tr(c.clone(), "Zielony", "Green"), cur.clone(), th.dark), swatch("yellow", tr(c.clone(), "Żółty", "Yellow"), cur.clone(), th.dark), swatch("orange", tr(c.clone(), "Pomarańczowy", "Orange"), cur.clone(), th.dark), swatch("red", tr(c.clone(), "Czerwony", "Red"), cur.clone(), th.dark), swatch("pink", tr(c.clone(), "Różowy", "Pink"), cur.clone(), th.dark), swatch("purple", tr(c.clone(), "Fioletowy", "Purple"), cur.clone(), th.dark) ]).spacing(2.0).align_y(1)
    let look: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Motyw", "Theme"), tr(c.clone(), "Szaro-czarny ciemny albo biało-jasnoszary jasny", "Gray-black dark or white/light-gray light"), "appearance.mode"), srow(th.clone(), tr(c.clone(), "Kolor akcentu", "Accent color"), tr(c.clone(), "Neutralny = biel/czerń zależnie od motywu", "Neutral = white/black depending on the theme"), sw), r_text(s.clone(), tr(c.clone(), "Własny akcent", "Custom accent"), tr(c.clone(), "np. #ff7a00 (nadpisuje wybór powyżej)", "e.g. #ff7a00 (overrides the choice above)"), "appearance.accent", "neutral"), r_slider(s.clone(), tr(c.clone(), "Zaokrąglenie", "Corner radius"), "", "appearance.radius", 0.0, 24.0, " px"), r_slider(s.clone(), tr(c.clone(), "Skala czcionki", "Font scale"), "", "appearance.font_scale", 80.0, 150.0, "%"), r_toggle(s.clone(), tr(c.clone(), "Animacje", "Animations"), "", "appearance.animations") ]
    let curs = ""
    let ci = 0
    while ci < s.cursors.len() and ci < 8 [
        if ci > 0 [
            curs = curs + ", "
        ]
        curs = curs + s.cursors[ci]
        ci = ci + 1
    ]
    let cur_rows: List<Element> = [ r_text(s.clone(), tr(c.clone(), "Motyw kursora", "Cursor theme"), tr(c.clone(), "puste = domyślny; znalezione: ", "empty = default; found: ") + curs, "appearance.cursor_theme", "Adwaita"), r_slider(s.clone(), tr(c.clone(), "Rozmiar kursora", "Cursor size"), tr(c.clone(), "Zmiana działa po ponownym zalogowaniu", "Takes effect after logging in again"), "appearance.cursor_size", 16.0, 48.0, " px"), r_toggle(s.clone(), tr(c.clone(), "Synchronizuj z aplikacjami GTK", "Sync with GTK apps"), tr(c.clone(), "Jasny/ciemny motyw i kursor przez gsettings", "Light/dark mode and cursor via gsettings"), "appearance.gtk_sync") ]
    end column([ page_head(s.clone(), 0), group(th.clone(), tr(c.clone(), "Motyw", "Theme"), look), group(th.clone(), tr(c.clone(), "Kursor i aplikacje GTK", "Cursor & GTK apps"), cur_rows) ]).spacing(20.0).fill_width()
]

fun wp_swatch(s: SState, i: Int) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let id = wall_preset_field(i, 0)
    let bw = 0.0
    let ring = 0
    if cget(c.clone(), "wallpaper.preset") == id and cget(c.clone(), "wallpaper.mode") == "gradient" [
        bw = 2.5
        ring = th.p.text
    ]
    let dot = container(space()).size_px(84.0, 52.0).radius(10.0).gradient(parse_color(wall_preset_field(i, 3)), parse_color(wall_preset_field(i, 4)), parse_f(wall_preset_field(i, 5))).border(bw, ring)
    end tooltip(button_with(dot).on_press("wp:" + id).class("ghost").padding(4.0).radius(12.0), tr(c.clone(), wall_preset_field(i, 1), wall_preset_field(i, 2)))
]

fun wp_presets_view(s: SState) -> Element [
    let rows: List<Element> = []
    let cur: List<Element> = []
    let n = wall_presets().len()
    let i = 0
    while i < n [
        cur.push(wp_swatch(s.clone(), i))
        if cur.len() == 6 or i == n - 1 [
            rows.push(row(cur).spacing(6.0))
            cur = []
        ]
        i = i + 1
    ]
    end container(column(rows).spacing(6.0)).padding(12.0)
]

fun wp_gallery(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let rows: List<Element> = []
    let total = s.wall_files.len()
    let per = 8
    let pages = (total + per - 1) / per
    let pg = iclamp(s.wall_page, 0, imax(pages - 1, 0))
    let cur = wall_effective(c.clone(), th.dark)
    let i = pg * per
    while i < total and i < pg * per + per [
        let f = s.wall_files[i].clone()
        let label = row([ icon("image").size(16.0), column([ text(wall_base(f.clone())).size(13.0), text(f.clone()).size(11.0).color(th.p.muted) ]).spacing(1.0).fill_width() ]).spacing(12.0).align_y(1)
        let b = button_with(label).on_press("wi:" + (i as Str)).class("ghost").fill_width().padding_xy(14.0, 7.0)
        b.st.ax = 0
        if f == cur [
            b = b.background(with_alpha(th.p.text, 24))
        ]
        rows.push(b)
        i = i + 1
    ]
    if total == 0 [
        rows.push(srow(th.clone(), tr(c.clone(), "Nie znaleziono obrazów", "No images found"), tr(c.clone(), "Szukano w ~/Pictures, ~/Pictures/Wallpapers, ~/.local/share/hwde/wallpapers, /usr/share/backgrounds", "Searched ~/Pictures, ~/Pictures/Wallpapers, ~/.local/share/hwde/wallpapers, /usr/share/backgrounds"), text("")))
    ]
    let pager = row([ button("").with_icon("chevron-left").on_press("wgp:-1").class("ghost icon"), text(((pg + 1) as Str) + " / " + (imax(pages, 1) as Str)).size(13.0), button("").with_icon("chevron-right").on_press("wgp:1").class("ghost icon"), space().fill_width(), button(tr(c.clone(), "Odśwież listę", "Refresh list")).with_icon("refresh-cw").on_press("wref") ]).spacing(8.0).align_y(1).padding_xy(14.0, 8.0).fill_width()
    rows.push(pager)
    end column(rows).spacing(0.0).fill_width()
]

fun page_wallpaper(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let mode = cget(c.clone(), "wallpaper.mode")
    let kids: List<Element> = [ page_head(s.clone(), 1) ]
    let top: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Rodzaj tła", "Background type"), tr(c.clone(), "Gradient i kolor rysuje powłoka, obrazy i pokaz slajdów — swaybg", "Gradient and color are drawn by the shell, images and slideshow by swaybg"), "wallpaper.mode") ]
    if (mode == "image" or mode == "slideshow") and not hw_which("swaybg") [
        top.push(srow(th.clone(), tr(c.clone(), "Brak programu swaybg", "swaybg is not installed"), tr(c.clone(), "Zainstaluj swaybg, aby wyświetlać obrazy; do tego czasu działa gradient", "Install swaybg to show images; a gradient is used until then"), icon("triangle-alert").size(18.0)))
    ]
    kids.push(group(th.clone(), tr(c.clone(), "Tło", "Background"), top))
    kids.push(group(th.clone(), tr(c.clone(), "Gotowe gradienty", "Gradient presets"), [ wp_presets_view(s.clone()) ]))
    let own: List<Element> = [ r_text(s.clone(), tr(c.clone(), "Kolor 1", "Color 1"), tr(c.clone(), "puste = zgodnie z motywem; tło pod obrazem", "empty = follow theme; also the color behind an image"), "wallpaper.color1", "#2a2a2f"), r_text(s.clone(), tr(c.clone(), "Kolor 2", "Color 2"), tr(c.clone(), "koniec gradientu", "gradient end"), "wallpaper.color2", "#0a0a0b"), r_slider(s.clone(), tr(c.clone(), "Kąt gradientu", "Gradient angle"), "", "wallpaper.angle", 0.0, 360.0, "°") ]
    kids.push(group(th.clone(), tr(c.clone(), "Własny gradient / kolor", "Custom gradient / color"), own))
    let img: List<Element> = [ r_text(s.clone(), tr(c.clone(), "Plik obrazu", "Image file"), tr(c.clone(), "ścieżka, może zaczynać się od ~/", "path, may start with ~/"), "wallpaper.image", "~/Pictures/tapeta.png"), r_pick(s.clone(), tr(c.clone(), "Dopasowanie", "Fit"), "", "wallpaper.fit"), r_text(s.clone(), tr(c.clone(), "Obraz dla motywu ciemnego", "Image for the dark theme"), tr(c.clone(), "puste = ten sam obraz", "empty = same image"), "wallpaper.image_dark", ""), r_text(s.clone(), tr(c.clone(), "Obraz dla motywu jasnego", "Image for the light theme"), tr(c.clone(), "przełącza się razem z motywem (także automatycznym)", "switches with the theme (also the automatic one)"), "wallpaper.image_light", "") ]
    kids.push(group(th.clone(), tr(c.clone(), "Obraz", "Image"), img))
    kids.push(group(th.clone(), tr(c.clone(), "Znalezione obrazy (kliknij, aby ustawić)", "Found images (click to set)"), [ wp_gallery(s.clone()) ]))
    let slide: List<Element> = [ r_text(s.clone(), tr(c.clone(), "Folder", "Folder"), tr(c.clone(), "puste = wszystkie znalezione obrazy", "empty = all found images"), "wallpaper.folder", "~/Pictures/Wallpapers"), r_pick(s.clone(), tr(c.clone(), "Zmieniaj co", "Change every"), "", "wallpaper.interval"), r_pick(s.clone(), tr(c.clone(), "Kolejność", "Order"), "", "wallpaper.order") ]
    let ctl = row([ button(tr(c.clone(), "Poprzednia", "Previous")).with_icon("skip-back").on_press("wprev"), button(tr(c.clone(), "Następna", "Next")).with_icon("skip-forward").on_press("wnext"), button(tr(c.clone(), "Losowa", "Random")).with_icon("refresh-cw").on_press("wrand") ]).spacing(10.0).padding_xy(16.0, 12.0)
    slide.push(ctl)
    kids.push(group(th.clone(), tr(c.clone(), "Pokaz slajdów (tryb „Pokaz slajdów”)", "Slideshow (“Slideshow” mode)"), slide))
    let mons: List<Element> = []
    let i = 0
    while i < s.outputs.len() [
        let o = s.outputs[i].clone()
        mons.push(r_text(s.clone(), o.name.clone(), tr(c.clone(), "obraz tylko dla tego monitora; puste = wspólna tapeta", "image for this monitor only; empty = shared wallpaper"), "wallpaper.out." + o.name, "~/Pictures/" + o.name + ".png"))
        i = i + 1
    ]
    if mons.len() > 0 [
        kids.push(group(th.clone(), tr(c.clone(), "Tapeta osobno dla monitora", "Per-monitor wallpaper"), mons))
    ]
    end column(kids).spacing(20.0).fill_width()
]

fun page_panel(s: SState) -> Element [
    let c = s.c.clone()
    let th = s.th.clone()
    let a: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Położenie", "Position"), "", "panel.position"), r_toggle(s.clone(), tr(c.clone(), "Pływający panel", "Floating panel"), tr(c.clone(), "Zaokrąglony, z marginesem od krawędzi", "Rounded, with a margin from the edge"), "panel.floating"), r_slider(s.clone(), tr(c.clone(), "Wysokość", "Height"), "", "panel.height", 28.0, 64.0, " px"), r_slider(s.clone(), tr(c.clone(), "Margines", "Margin"), "", "panel.margin", 0.0, 24.0, " px"), r_slider(s.clone(), tr(c.clone(), "Przezroczystość tła", "Background opacity"), "", "appearance.panel_opacity", 40.0, 100.0, "%") ]
    let b: List<Element> = [ r_pick(s.clone(), tr(c.clone(), "Format godziny", "Clock format"), "", "panel.clock"), r_toggle(s.clone(), tr(c.clone(), "Sekundy", "Seconds"), "", "panel.seconds"), r_toggle(s.clone(), tr(c.clone(), "Data obok zegara", "Date next to the clock"), "", "panel.date"), r_slider(s.clone(), tr(c.clone(), "Maks. okien na pasku zadań", "Max. taskbar windows"), "", "panel.max_tasks", 2.0, 16.0, "") ]
    let m: List<Element> = [ r_text(s.clone(), tr(c.clone(), "Lewa strona", "Left side"), tr(c.clone(), "moduły: launcher, tasks, clock, date, status, power, lock, settings", "modules: launcher, tasks, clock, date, status, power, lock, settings"), "panel.left", "launcher,tasks"), r_text(s.clone(), tr(c.clone(), "Środek", "Center"), "", "panel.center", "clock"), r_text(s.clone(), tr(c.clone(), "Prawa strona", "Right side"), "", "panel.right", "status,power") ]
